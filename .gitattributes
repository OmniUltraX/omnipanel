# 统一换行：仓库与工作区均使用 LF，避免 Windows 上
# core.autocrlf=true 时反复出现 “LF will be replaced by CRLF” 警告。
* text=auto eol=lf

# 明确按文本处理的常见源码
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不碰换行
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.7z binary
*.gz binary
*.exe binary
*.dll binary
*.pdb binary
*.rlib binary
*.rmeta binary
