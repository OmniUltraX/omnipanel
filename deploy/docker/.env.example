# Exact Docker-only release; verify successful workflow / public digest before deployment.
# For source-only tests set OMNIPANEL_IMAGE=omnipanel-web:local instead.
OMNIPANEL_IMAGE=ghcr.io/omniultrax/omnipanel-web:0.8.57
# Set locally; never commit actual keys. Use a long random value.
OMNIPANEL_API_KEY=
OMNIPANEL_BIND_HOST=127.0.0.1
OMNIPANEL_PORT=8899
# Set 1 when serving HTTPS behind a reverse proxy (preserve Host).
OMNIPANEL_SECURE_COOKIE=0
