{
  "id": "omni.cloud.digitalocean",
  "version": "0.1.0",
  "displayName": "DigitalOcean",
  "kind": "cloud",
  "permissions": ["connections:write", "net:connect", "vault:read"],
  "entry": { "logic": "logic.js" },
  "methods": [
    { "name": "testAccount", "permissions": ["net:connect", "vault:read"] },
    { "name": "listRegions", "permissions": ["net:connect", "vault:read"] },
    { "name": "getAccount", "permissions": ["net:connect", "vault:read"] },
    { "name": "listResources", "permissions": ["net:connect", "vault:read"] },
    { "name": "getResource", "permissions": ["net:connect", "vault:read"] },
    {
      "name": "invokeAction",
      "permissions": ["net:connect", "vault:read"],
      "dangerAction": "cloud.instance.lifecycle"
    },
    { "name": "getMetrics", "permissions": ["net:connect", "vault:read"] },
    { "name": "queryLogs", "permissions": ["net:connect", "vault:read"] }
  ],
  "contributes": {
    "ui": {
      "sidebar": true,
      "connectionForm": {
        "fields": [
          { "key": "accessKeyId", "type": "text" },
          { "key": "accessKeySecret", "type": "password" },
          { "key": "regions", "type": "multiselect" }
        ]
      }
    },
    "cloud": {
      "capabilities": [
        {
          "id": "compute",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "security", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "instanceType" },
            { "key": "zone" },
            { "key": "publicIp" },
            { "key": "privateIp" },
            { "key": "expiredTime" },
            { "key": "chargeType" },
            { "key": "securityGroups" },
            { "key": "os" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "attach", "kind": "plugin" },
            { "id": "detach", "kind": "plugin" },
            { "id": "addSsh", "kind": "host" },
            { "id": "createSnapshot", "kind": "plugin" }
          ]
        },
        {
          "id": "compute.lite",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "rules", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "plan" },
            { "key": "publicIp" },
            { "key": "privateIp" },
            { "key": "expiredTime" },
            { "key": "chargeType" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" },
            { "id": "addSsh", "kind": "host" },
            { "id": "createSnapshot", "kind": "plugin" }
          ]
        },
        {
          "id": "network.securityGroup",
          "scope": "region",
          "detailSlots": ["overview", "rules", "members"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "vpcId" },
            { "key": "instanceCount" },
            { "key": "description" },
            { "key": "creationTime" }
          ],
          "actions": [
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" }
          ]
        },
        {
          "id": "network.eip",
          "scope": "region",
          "detailSlots": ["overview", "metrics"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "publicIp" },
            { "key": "bandwidth" },
            { "key": "instanceId" },
            { "key": "chargeType" }
          ],
          "actions": [
            { "id": "attach", "kind": "plugin" },
            { "id": "detach", "kind": "plugin" },
            { "id": "modifyBandwidth", "kind": "plugin" }
          ]
        },
        {
          "id": "network.loadBalancer",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "members"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "publicIp" },
            { "key": "addressType" },
            { "key": "instanceClass" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" }
          ]
        },
        {
          "id": "database",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "logs", "rules", "members", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "engine" },
            { "key": "engineVersion" },
            { "key": "instanceClass" },
            { "key": "storage" },
            { "key": "connectionString" },
            { "key": "port" },
            { "key": "expiredTime" },
            { "key": "chargeType" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" },
            { "id": "addToDatabase", "kind": "host" }
          ]
        },
        {
          "id": "database.cache",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "logs", "rules"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "engine" },
            { "key": "engineVersion" },
            { "key": "instanceClass" },
            { "key": "capacity" },
            { "key": "connectionString" },
            { "key": "port" },
            { "key": "expiredTime" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" },
            { "id": "addToDatabase", "kind": "host" }
          ]
        },
        {
          "id": "storage.disk",
          "scope": "region",
          "detailSlots": ["overview", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "size" },
            { "key": "category" },
            { "key": "type" },
            { "key": "instanceId" },
            { "key": "zone" }
          ],
          "actions": [
            { "id": "attach", "kind": "plugin" },
            { "id": "detach", "kind": "plugin" },
            { "id": "createSnapshot", "kind": "plugin" }
          ]
        },
        {
          "id": "objectStorage",
          "scope": "region",
          "detailSlots": ["overview"],
          "columns": [
            { "key": "name" },
            { "key": "region" },
            { "key": "storageClass" },
            { "key": "creationDate" },
            { "key": "endpoint" }
          ],
          "actions": [
            { "id": "addToFiles", "kind": "host" }
          ]
        },
        {
          "id": "domains",
          "scope": "global",
          "detailSlots": ["overview", "records"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "type" },
            { "key": "registrationDate" },
            { "key": "expirationDate" },
            { "key": "recordCount" }
          ],
          "actions": [
            { "id": "addRecord", "kind": "plugin" },
            { "id": "updateRecord", "kind": "plugin" },
            { "id": "deleteRecord", "kind": "plugin" }
          ]
        },
        {
          "id": "certs",
          "scope": "global",
          "detailSlots": ["overview"],
          "columns": [
            { "key": "name" },
            { "key": "domain" },
            { "key": "status" },
            { "key": "product" },
            { "key": "certType" },
            { "key": "endDate" }
          ],
          "actions": []
        }
      ],
      "regions": [
        { "id": "nyc1", "label": "New York 1" },
        { "id": "nyc3", "label": "New York 3" },
        { "id": "sfo3", "label": "San Francisco 3" },
        { "id": "ams3", "label": "Amsterdam 3" },
        { "id": "lon1", "label": "London 1" },
        { "id": "fra1", "label": "Frankfurt 1" },
        { "id": "sgp1", "label": "Singapore 1" },
        { "id": "tor1", "label": "Toronto 1" },
        { "id": "blr1", "label": "Bangalore 1" },
        { "id": "syd1", "label": "Sydney 1" }
      ]
    }
  }
}
