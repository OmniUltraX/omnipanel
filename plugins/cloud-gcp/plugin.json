{
  "id": "omni.cloud.gcp",
  "version": "0.1.0",
  "displayName": "Google Cloud",
  "kind": "cloud",
  "permissions": ["connections:write", "net:connect", "vault:read"],
  "entry": { "logic": "logic.js" },
  "methods": [
    { "name": "testAccount", "permissions": ["net:connect", "vault:read"] },
    { "name": "listRegions", "permissions": ["net:connect", "vault:read"] },
    { "name": "getAccount", "permissions": ["net:connect", "vault:read"] },
    { "name": "listResources", "permissions": ["net:connect", "vault:read"] },
    { "name": "getResource", "permissions": ["net:connect", "vault:read"] },
    {
      "name": "invokeAction",
      "permissions": ["net:connect", "vault:read"],
      "dangerAction": "cloud.instance.lifecycle"
    },
    { "name": "getMetrics", "permissions": ["net:connect", "vault:read"] },
    { "name": "queryLogs", "permissions": ["net:connect", "vault:read"] }
  ],
  "contributes": {
    "ui": {
      "sidebar": true,
      "connectionForm": {
        "fields": [
          { "key": "accessKeyId", "type": "text" },
          { "key": "accessKeySecret", "type": "password" },
          { "key": "regions", "type": "multiselect" }
        ]
      }
    },
    "cloud": {
      "capabilities": [
        {
          "id": "compute",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "security", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "instanceType" },
            { "key": "zone" },
            { "key": "publicIp" },
            { "key": "privateIp" },
            { "key": "expiredTime" },
            { "key": "chargeType" },
            { "key": "securityGroups" },
            { "key": "os" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "attach", "kind": "plugin" },
            { "id": "detach", "kind": "plugin" },
            { "id": "addSsh", "kind": "host" },
            { "id": "createSnapshot", "kind": "plugin" }
          ]
        },
        {
          "id": "compute.lite",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "rules", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "plan" },
            { "key": "publicIp" },
            { "key": "privateIp" },
            { "key": "expiredTime" },
            { "key": "chargeType" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" },
            { "id": "addSsh", "kind": "host" },
            { "id": "createSnapshot", "kind": "plugin" }
          ]
        },
        {
          "id": "network.securityGroup",
          "scope": "region",
          "detailSlots": ["overview", "rules", "members"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "vpcId" },
            { "key": "instanceCount" },
            { "key": "description" },
            { "key": "creationTime" }
          ],
          "actions": [
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" }
          ]
        },
        {
          "id": "network.eip",
          "scope": "region",
          "detailSlots": ["overview", "metrics"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "publicIp" },
            { "key": "bandwidth" },
            { "key": "instanceId" },
            { "key": "chargeType" }
          ],
          "actions": [
            { "id": "attach", "kind": "plugin" },
            { "id": "detach", "kind": "plugin" },
            { "id": "modifyBandwidth", "kind": "plugin" }
          ]
        },
        {
          "id": "network.loadBalancer",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "members"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "publicIp" },
            { "key": "addressType" },
            { "key": "instanceClass" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" }
          ]
        },
        {
          "id": "database",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "logs", "rules", "members", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "engine" },
            { "key": "engineVersion" },
            { "key": "instanceClass" },
            { "key": "storage" },
            { "key": "connectionString" },
            { "key": "port" },
            { "key": "expiredTime" },
            { "key": "chargeType" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" },
            { "id": "addToDatabase", "kind": "host" }
          ]
        },
        {
          "id": "database.cache",
          "scope": "region",
          "detailSlots": ["overview", "metrics", "logs", "rules"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "engine" },
            { "key": "engineVersion" },
            { "key": "instanceClass" },
            { "key": "capacity" },
            { "key": "connectionString" },
            { "key": "port" },
            { "key": "expiredTime" }
          ],
          "actions": [
            { "id": "start", "kind": "plugin" },
            { "id": "stop", "kind": "plugin" },
            { "id": "reboot", "kind": "plugin" },
            { "id": "authorizeRule", "kind": "plugin" },
            { "id": "revokeRule", "kind": "plugin" },
            { "id": "addToDatabase", "kind": "host" }
          ]
        },
        {
          "id": "storage.disk",
          "scope": "region",
          "detailSlots": ["overview", "backups"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "region" },
            { "key": "size" },
            { "key": "category" },
            { "key": "type" },
            { "key": "instanceId" },
            { "key": "zone" }
          ],
          "actions": [
            { "id": "attach", "kind": "plugin" },
            { "id": "detach", "kind": "plugin" },
            { "id": "createSnapshot", "kind": "plugin" }
          ]
        },
        {
          "id": "objectStorage",
          "scope": "region",
          "detailSlots": ["overview"],
          "columns": [
            { "key": "name" },
            { "key": "region" },
            { "key": "storageClass" },
            { "key": "creationDate" },
            { "key": "endpoint" }
          ],
          "actions": [
            { "id": "addToFiles", "kind": "host" }
          ]
        },
        {
          "id": "domains",
          "scope": "global",
          "detailSlots": ["overview", "records"],
          "columns": [
            { "key": "name" },
            { "key": "status" },
            { "key": "type" },
            { "key": "registrationDate" },
            { "key": "expirationDate" },
            { "key": "recordCount" }
          ],
          "actions": [
            { "id": "addRecord", "kind": "plugin" },
            { "id": "updateRecord", "kind": "plugin" },
            { "id": "deleteRecord", "kind": "plugin" }
          ]
        },
        {
          "id": "certs",
          "scope": "global",
          "detailSlots": ["overview"],
          "columns": [
            { "key": "name" },
            { "key": "domain" },
            { "key": "status" },
            { "key": "product" },
            { "key": "certType" },
            { "key": "endDate" }
          ],
          "actions": []
        }
      ],
      "regions": [
        { "id": "us-central1", "label": "US Central (Iowa)" },
        { "id": "us-east1", "label": "US East (South Carolina)" },
        { "id": "us-east4", "label": "US East (Northern Virginia)" },
        { "id": "us-west1", "label": "US West (Oregon)" },
        { "id": "us-west2", "label": "US West (Los Angeles)" },
        { "id": "us-west3", "label": "US West (Salt Lake City)" },
        { "id": "us-west4", "label": "US West (Las Vegas)" },
        { "id": "europe-west1", "label": "Europe West (Belgium)" },
        { "id": "europe-west2", "label": "Europe West (London)" },
        { "id": "europe-west3", "label": "Europe West (Frankfurt)" },
        { "id": "europe-west4", "label": "Europe West (Netherlands)" },
        { "id": "europe-west6", "label": "Europe West (Zurich)" },
        { "id": "europe-north1", "label": "Europe North (Finland)" },
        { "id": "asia-east1", "label": "Asia East (Taiwan)" },
        { "id": "asia-east2", "label": "Asia East (Hong Kong)" },
        { "id": "asia-northeast1", "label": "Asia Northeast (Tokyo)" },
        { "id": "asia-northeast2", "label": "Asia Northeast (Osaka)" },
        { "id": "asia-northeast3", "label": "Asia Northeast (Seoul)" },
        { "id": "asia-south1", "label": "Asia South (Mumbai)" },
        { "id": "asia-southeast1", "label": "Asia Southeast (Singapore)" },
        { "id": "asia-southeast2", "label": "Asia Southeast (Jakarta)" },
        { "id": "australia-southeast1", "label": "Australia Southeast (Sydney)" },
        { "id": "australia-southeast2", "label": "Australia Southeast (Melbourne)" },
        { "id": "southamerica-east1", "label": "South America East (São Paulo)" },
        { "id": "northamerica-northeast1", "label": "North America Northeast (Montréal)" },
        { "id": "northamerica-northeast2", "label": "North America Northeast (Toronto)" }
      ]
    }
  }
}
