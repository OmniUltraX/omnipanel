{
  "name": "@omnipanel/plugin-sdk",
  "version": "0.1.0",
  "description": "OmniPanel plugin SDK: manifest schema, Host API types and contracts (L1/L2/L3)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmniUltraX/omnipanel.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/OmniUltraX/omnipanel/tree/master/packages/plugin-sdk",
  "bugs": {
    "url": "https://github.com/OmniUltraX/omnipanel/issues"
  },
  "keywords": ["omnipanel", "plugin", "sdk", "manifest"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
